# ---- Required ----
# MongoDB connection string
MONGODB_URI=your_value_here
# JWT signing secret. MUST be random and >= 32 chars (the server refuses to
# start otherwise). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_value_here

# ---- Optional ----
PORT=4001
NODE_ENV=development
# Comma-separated list of allowed browser origins (required in production).
# Example: https://hireflow.vercel.app,https://www.hireflow.app
CORS_ORIGINS=http://localhost:3000
JWT_EXPIRES_IN=7d

# Cloudinary - for resume file storage
CLOUDINARY_CLOUD_NAME=your_value_here
CLOUDINARY_API_KEY=your_value_here
CLOUDINARY_API_SECRET=your_value_here

# Gemini AI - resume generation, interview prep, and job match reasoning
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_value_here
# Optional separate key used only for interview prep (falls back to GEMINI_API_KEY)
GEMINI_INTERVIEW_API_KEY=

# Python AI Backend - skill expansion microservice (ai-backend/)
AI_BACKEND_URL=http://localhost:5001

# Job sources to aggregate (comma-separated). Supported: remotive, arbeitnow, remoteok
JOB_SOURCES=remotive,arbeitnow,remoteok
